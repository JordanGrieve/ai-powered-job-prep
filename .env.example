# ---------------------------------------------------------------------------
# Copy this file to `.env` (NOT `.env.local`).
#
# docker compose only ever reads `.env`, and docker-compose.yml interpolates
# the DB_* group below to configure the Postgres container. Using `.env.local`
# gives you a working Next.js app next to a Postgres container configured with
# empty strings.
#
# Every variable here is validated at module load by app/data/env/server.ts and
# app/data/env/client.ts. A missing or empty value fails `next dev`, `next
# build`, and every drizzle-kit script immediately.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
# EITHER set DATABASE_URL directly (hosted Postgres - Neon, Supabase, Vercel
# Postgres). This is what any real deployment will give you, and it wins over
# the DB_* group below:
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
#
# OR set all five DB_* parts and let the app compose the URL. docker-compose.yml
# interpolates this group to configure the local container, so keep it filled in
# if you are using Docker.
# Consumed by docker-compose.yml AND assembled into DATABASE_URL by
# app/data/env/server.ts. DB_HOST/DB_PORT are how *your machine* reaches the
# container, so localhost and the published port.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=job_prep

# --- Clerk (auth + billing) ------------------------------------------------
# https://dashboard.clerk.com -> your app -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Path to the in-repo sign-in route.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk dashboard -> Configure -> Webhooks -> your endpoint -> Signing Secret.
# The endpoint must point at <your-url>/api/webhooks/clerk and subscribe to
# user.created, user.updated and user.deleted. Without it no users row is ever
# written and every new sign-up hangs on the onboarding screen.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Hume AI (empathic voice interviewer) ----------------------------------
# https://platform.hume.ai -> API keys
HUME_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
HUME_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# https://platform.hume.ai -> EVI -> Configs -> your config -> id.
# The config's prompt MUST declare the template variables userName, title,
# description and experienceLevel - see README. Hume silently drops session
# variables it does not recognise.
NEXT_PUBLIC_HUME_CONFIG_ID=00000000-0000-0000-0000-000000000000

# --- Google Gemini (written feedback) --------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Defaults to gemini-2.5-flash when unset.
# GEMINI_MODEL=gemini-2.5-flash

# --- Arcjet (shield, bot detection, rate limiting) -------------------------
# https://app.arcjet.com -> your site -> SDK key
ARCJET_KEY=ajkey_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Local seeding (optional) ----------------------------------------------
# Your Clerk user id, so `npm run db:seed` attaches its fixtures to your
# account. Clerk dashboard -> Users, or read it out of the users table after
# the webhook has fired. Can also be passed as an argument:
#   npm run db:seed -- user_2abc...
# SEED_CLERK_USER_ID=user_2abc...

# --- E2E tests (optional) --------------------------------------------------
# A DEDICATED Clerk test user (email + password strategy). The Playwright
# suite signs in as this account and creates data as it. Do not use a real one.
# E2E_CLERK_USER_IDENTIFIER=e2e@example.com
# E2E_CLERK_USER_PASSWORD=
#
# Set to DRY_RUN only for local e2e runs. playwright.config.ts sets it for the
# dev server it starts; never set it in production.
# ARCJET_MODE=LIVE
